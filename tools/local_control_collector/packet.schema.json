{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EA_LAB_LOCAL_CONTROL_COLLECTOR_V1",
  "title": "EA LAB Local Control Collector V1 packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observed_at", "git", "registry", "jobs", "evidence", "codex_usage", "daily_aggregation", "bindings", "limitations", "runtime_mutation", "installation_actions"],
  "properties": {
    "schema_version": {"const": "EA_LAB_LOCAL_CONTROL_COLLECTOR_V1"},
    "observed_at": {"type": "string"},
    "git": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "fetch", "head", "origin_master", "ls_remote_master", "clean", "ancestry", "changed_paths", "overlap"],
      "properties": {
        "status": {"type": "string"}, "fetch": {"type": "string"}, "head": {"type": "string"}, "origin_master": {"type": "string"}, "ls_remote_master": {"type": "string"}, "clean": {"type": ["boolean", "null"]}, "ancestry": {"type": "string"},
        "changed_paths": {"type": "array", "items": {"type": "string"}}, "overlap": {"type": "array", "items": {"$ref": "#/$defs/overlap"}}
      }
    },
    "registry": {
      "type": "object", "additionalProperties": false, "required": ["status", "records", "conflicts", "reason"],
      "properties": {"status": {"type": "string"}, "reason": {"type": "string"}, "records": {"type": "array", "items": {"$ref": "#/$defs/lane"}}, "conflicts": {"type": "array", "items": {"$ref": "#/$defs/overlap"}}}
    },
    "jobs": {"type": "array", "items": {"$ref": "#/$defs/job"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "codex_usage": {
      "type": "object", "additionalProperties": false, "required": ["status", "captured_at", "truth_note", "threads", "unavailable_database_count", "ambiguous_duplicate_thread_count"],
      "properties": {"status": {"type": "string"}, "captured_at": {"type": "string"}, "truth_note": {"type": "string"}, "threads": {"type": "array", "items": {"$ref": "#/$defs/thread"}}, "unavailable_database_count": {"type": "integer", "minimum": 0}, "ambiguous_duplicate_thread_count": {"type": "integer", "minimum": 0}}
    },
    "daily_aggregation": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "valid_delta_tokens", "valid_delta_thread_count", "observed_thread_count", "observed_invocation_count", "observation_thresholds", "observation_signal", "by_lane", "by_milestone", "by_model", "by_reasoning_effort", "by_role", "top_delta_threads"],
      "properties": {
        "date": {"type": "string"}, "valid_delta_tokens": {"type": "integer", "minimum": 0}, "valid_delta_thread_count": {"type": "integer", "minimum": 0}, "observed_thread_count": {"type": "integer", "minimum": 0}, "observed_invocation_count": {"type": "integer", "minimum": 0},
        "observation_thresholds": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}}, "observation_signal": {"enum": ["WITHIN_OBSERVATION", "ELEVATED", "HIGH"]},
        "by_lane": {"type": "array", "items": {"$ref": "#/$defs/lane_group"}}, "by_milestone": {"type": "array", "items": {"$ref": "#/$defs/milestone_group"}}, "by_model": {"type": "array", "items": {"$ref": "#/$defs/model_group"}}, "by_reasoning_effort": {"type": "array", "items": {"$ref": "#/$defs/reasoning_group"}}, "by_role": {"type": "array", "items": {"$ref": "#/$defs/role_group"}}, "top_delta_threads": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/top_delta"}}
      }
    },
    "bindings": {"type": "object", "additionalProperties": false, "required": ["collector_sha256", "schema_sha256"], "properties": {"collector_sha256": {"type": "string"}, "schema_sha256": {"type": "string"}}},
    "limitations": {"type": "array", "items": {"type": "string"}}, "runtime_mutation": {"const": false}, "installation_actions": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "overlap": {"type": "object", "additionalProperties": false, "required": ["changed_path", "lane_id", "allowed_paths", "critical_paths", "classification"], "properties": {"changed_path": {"type": "string"}, "lane_id": {"type": "string"}, "allowed_paths": {"type": "array", "items": {"type": "string"}}, "critical_paths": {"type": "array", "items": {"type": "string"}}, "classification": {"enum": ["ALLOWED", "CRITICAL"]}}},
    "lane": {"type": "object", "additionalProperties": false, "required": ["lane_id", "state", "role", "owner_chat", "head", "reviewed_head", "blocker_class", "updated_at", "worktree", "classification", "allowed_paths", "critical_paths"], "properties": {"lane_id": {"type": "string"}, "state": {"type": "string"}, "role": {"type": "string"}, "owner_chat": {"type": "string"}, "head": {"type": "string"}, "reviewed_head": {"type": "string"}, "blocker_class": {"type": "string"}, "updated_at": {"type": "string"}, "worktree": {"type": "string"}, "classification": {"type": "string"}, "allowed_paths": {"type": "array", "items": {"type": "string"}}, "critical_paths": {"type": "array", "items": {"type": "string"}}}},
    "job": {"type": "object", "additionalProperties": false, "required": ["status", "lane_id", "job_id", "durable_state", "result", "runner_alive", "child_alive", "postcondition_alive", "heartbeat_age_sec", "retry_decision", "lease_identity", "job_identity"], "properties": {"status": {"type": "string"}, "lane_id": {"type": "string"}, "job_id": {"type": "string"}, "durable_state": {"type": "string"}, "result": {"type": "string"}, "runner_alive": {"type": ["boolean", "null"]}, "child_alive": {"type": ["boolean", "null"]}, "postcondition_alive": {"type": ["boolean", "null"]}, "heartbeat_age_sec": {"type": ["number", "null"], "minimum": 0}, "retry_decision": {"type": "string"}, "lease_identity": {"type": "string"}, "job_identity": {"type": "string"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["status", "contract", "verdict", "confidence", "decision", "findings", "reviewed_head", "sha256", "source"], "properties": {"status": {"type": "string"}, "contract": {"type": "string"}, "verdict": {"type": "string"}, "confidence": {"type": "string"}, "decision": {"type": "string"}, "findings": {"type": "array", "items": {"type": "string"}}, "reviewed_head": {"type": "string"}, "sha256": {"type": "string"}, "source": {"type": "string"}}},
    "thread": {"type": "object", "additionalProperties": false, "required": ["thread_id", "label", "model", "reasoning_effort", "current_lifetime_tokens", "previous_lifetime_tokens", "delta_tokens", "delta_status", "updated_at_ms", "parent_thread_id", "identity", "lane_id", "milestone", "role", "mapping_status", "invocation_count"], "properties": {"thread_id": {"type": "string"}, "label": {"type": "string"}, "model": {"type": "string"}, "reasoning_effort": {"type": "string"}, "current_lifetime_tokens": {"type": ["integer", "null"], "minimum": 0}, "previous_lifetime_tokens": {"type": ["integer", "null"], "minimum": 0}, "delta_tokens": {"type": ["integer", "null"], "minimum": 0}, "delta_status": {"enum": ["INITIAL", "DELTA_OK", "COUNTER_DECREASED_UNKNOWN", "UNKNOWN"]}, "updated_at_ms": {"type": ["integer", "null"], "minimum": 0}, "parent_thread_id": {"type": ["string", "null"]}, "identity": {"enum": ["PARENT", "CHILD"]}, "lane_id": {"type": "string"}, "milestone": {"type": "string"}, "role": {"type": "string"}, "mapping_status": {"enum": ["EXACT", "AMBIGUOUS", "UNKNOWN"]}, "invocation_count": {"type": "integer", "minimum": 0}}},
    "lane_group": {"type": "object", "additionalProperties": false, "required": ["lane_id", "delta_tokens"], "properties": {"lane_id": {"type": "string"}, "delta_tokens": {"type": "integer", "minimum": 0}}},
    "milestone_group": {"type": "object", "additionalProperties": false, "required": ["milestone", "delta_tokens"], "properties": {"milestone": {"type": "string"}, "delta_tokens": {"type": "integer", "minimum": 0}}},
    "model_group": {"type": "object", "additionalProperties": false, "required": ["model", "delta_tokens"], "properties": {"model": {"type": "string"}, "delta_tokens": {"type": "integer", "minimum": 0}}},
    "reasoning_group": {"type": "object", "additionalProperties": false, "required": ["reasoning_effort", "delta_tokens"], "properties": {"reasoning_effort": {"type": "string"}, "delta_tokens": {"type": "integer", "minimum": 0}}},
    "role_group": {"type": "object", "additionalProperties": false, "required": ["role", "delta_tokens"], "properties": {"role": {"type": "string"}, "delta_tokens": {"type": "integer", "minimum": 0}}},
    "top_delta": {"type": "object", "additionalProperties": false, "required": ["thread_id", "delta_tokens"], "properties": {"thread_id": {"type": "string"}, "delta_tokens": {"type": "integer", "minimum": 0}}}
  }
}
