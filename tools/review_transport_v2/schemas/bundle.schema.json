{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "requested_head": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "(?:[0-9a-f]{40}|[0-9a-f]{64})"
    },
    "git_tree_oid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "(?:[0-9a-f]{40}|[0-9a-f]{64})"
    },
    "git_object_format": {
      "type": "string",
      "enum": [
        "sha1",
        "sha256"
      ]
    },
    "source_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "identity": {
            "type": "object",
            "properties": {
              "device": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "inode": {
                "type": "integer",
                "minimum": 1,
                "maximum": 340282366920938463463374607431768211455
              }
            },
            "required": [
              "device",
              "inode"
            ],
            "additionalProperties": false
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "[0-9a-f]{64}"
          },
          "blob_oid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "(?:[0-9a-f]{40}|[0-9a-f]{64})"
          }
        },
        "required": [
          "id",
          "path",
          "identity",
          "size",
          "sha256",
          "blob_oid"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "evidence_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "identity": {
            "type": "object",
            "properties": {
              "device": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "inode": {
                "type": "integer",
                "minimum": 1,
                "maximum": 340282366920938463463374607431768211455
              }
            },
            "required": [
              "device",
              "inode"
            ],
            "additionalProperties": false
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "[0-9a-f]{64}"
          }
        },
        "required": [
          "id",
          "path",
          "identity",
          "size",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "git_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}"
          },
          "oid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "(?:[0-9a-f]{40}|[0-9a-f]{64})"
          },
          "type": {
            "type": "string",
            "enum": [
              "commit",
              "tree",
              "blob"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "[0-9a-f]{64}"
          }
        },
        "required": [
          "id",
          "oid",
          "type",
          "size",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 4096
    }
  },
  "required": [
    "schema_version",
    "requested_head",
    "git_tree_oid",
    "git_object_format",
    "source_entries",
    "evidence_entries",
    "git_objects"
  ],
  "additionalProperties": false
}
