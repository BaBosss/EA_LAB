{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ea-lab.local/schemas/codex-budget-packet-input-v1.json",
  "title": "EA_LAB Codex compact packet input",
  "oneOf": [
    {"$ref": "#/$defs/task"},
    {"$ref": "#/$defs/review"}
  ],
  "$defs": {
    "identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "plainString": {"type": "string", "minLength": 1, "pattern": "^[^\\s\\x00-\\x1f](?:[^\\x00-\\x1f]*[^\\s\\x00-\\x1f])?$"},
    "stringList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/plainString"}},
    "repoPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*:)(?!.*\/$).+$"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "sha256"],
      "properties": {
        "locator": {"$ref": "#/$defs/plainString"},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "bytes_base64": {"type": "string", "minLength": 1, "contentEncoding": "base64"}
      }
    },
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "requirement"],
      "properties": {
        "gate_id": {"$ref": "#/$defs/identity"},
        "requirement": {"$ref": "#/$defs/plainString"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "packet_type", "task_id", "lane_id", "source_head", "objective", "allowed_paths", "forbidden_operations", "authority_ceiling", "direct_consumer", "downstream_skip", "unique_output", "source_records", "evidence_records", "required_gates", "repair_used", "repair_limit"],
      "properties": {
        "schema_version": {"const": "codex_budget_packet_input/1"},
        "packet_type": {"const": "TASK_PACKET"},
        "mode": {"enum": ["NORMAL", "ECONOMY"], "default": "NORMAL"},
        "task_id": {"$ref": "#/$defs/identity"},
        "lane_id": {"$ref": "#/$defs/identity"},
        "source_head": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "objective": {"$ref": "#/$defs/plainString"},
        "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}},
        "forbidden_operations": {"$ref": "#/$defs/stringList"},
        "authority_ceiling": {"$ref": "#/$defs/stringList"},
        "direct_consumer": {"$ref": "#/$defs/plainString"},
        "downstream_skip": {"$ref": "#/$defs/stringList"},
        "unique_output": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.json$"},
        "source_records": {"$ref": "#/$defs/records"},
        "evidence_records": {"$ref": "#/$defs/records"},
        "required_gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}},
        "repair_used": {"type": "integer", "minimum": 0},
        "repair_limit": {"type": "integer", "minimum": 0}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "packet_type", "task_id", "lane_id", "source_head", "objective", "allowed_paths", "forbidden_operations", "authority_ceiling", "direct_consumer", "downstream_skip", "unique_output", "source_records", "evidence_records", "required_gates", "repair_used", "repair_limit", "author_job_id", "author_lane_id", "reviewer_job_id", "reviewer_lane_id", "reviewed_head", "evidence_identity"],
      "properties": {
        "schema_version": {"const": "codex_budget_packet_input/1"},
        "packet_type": {"const": "REVIEW_PACKET"},
        "mode": {"enum": ["NORMAL", "ECONOMY"], "default": "NORMAL"},
        "task_id": {"$ref": "#/$defs/identity"},
        "lane_id": {"$ref": "#/$defs/identity"},
        "source_head": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "objective": {"$ref": "#/$defs/plainString"},
        "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}},
        "forbidden_operations": {"$ref": "#/$defs/stringList"},
        "authority_ceiling": {"$ref": "#/$defs/stringList"},
        "direct_consumer": {"$ref": "#/$defs/plainString"},
        "downstream_skip": {"$ref": "#/$defs/stringList"},
        "unique_output": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.json$"},
        "source_records": {"$ref": "#/$defs/records"},
        "evidence_records": {"$ref": "#/$defs/records"},
        "required_gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}},
        "repair_used": {"type": "integer", "minimum": 0},
        "repair_limit": {"type": "integer", "minimum": 0},
        "author_job_id": {"$ref": "#/$defs/identity"},
        "author_lane_id": {"$ref": "#/$defs/identity"},
        "reviewer_job_id": {"$ref": "#/$defs/identity"},
        "reviewer_lane_id": {"$ref": "#/$defs/identity"},
        "reviewed_head": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "evidence_identity": {"$ref": "#/$defs/plainString"}
      }
    }
  }
}
