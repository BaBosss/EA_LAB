# Local secrets & credentials
scripts/config.yaml
*.env
secrets.*
**/credentials*
# MT5 terminal configs with live account info
terminal.ini
terminalmt5.ini

# Staging drop folder for manual MT5 reports (transient)
_inbox/

# Runtime logs and generated outputs
logs/*
ea_projects/*/logs/*
ea_projects/*/backtest/*
ea_projects/*/optimization/*
ea_projects/*/reports/latest/*

# Keep folder placeholders
!logs/.gitkeep
!ea_projects/_template/logs/.gitkeep
!ea_projects/_template/backtest/.gitkeep
!ea_projects/_template/backtest/manual_runs/
!ea_projects/_template/backtest/manual_runs/run_001/
!ea_projects/_template/backtest/manual_runs/run_001/report.html
!ea_projects/_template/backtest/manual_runs/run_001/trade_list.csv
!ea_projects/_template/backtest/manual_runs/run_001/set_used.set
!ea_projects/_template/backtest/manual_runs/run_001/run_context.yaml
!ea_projects/_template/backtest/manual_runs/run_001/notes.txt
!ea_projects/_template/optimization/.gitkeep
!ea_projects/_template/optimization/plans/
!ea_projects/_template/optimization/plans/.gitkeep
!ea_projects/_template/optimization/raw_results/
!ea_projects/_template/optimization/raw_results/.gitkeep
!ea_projects/_template/optimization/analyzed/
!ea_projects/_template/optimization/analyzed/.gitkeep
!ea_projects/_template/optimization/candidates/
!ea_projects/_template/optimization/candidates/.gitkeep
!ea_projects/_template/optimization/oos/
!ea_projects/_template/optimization/oos/.gitkeep
!ea_projects/_template/reports/.gitkeep

# Python cache
__pycache__/
*.pyc

# compiled MQL5 binaries
*.ex5
*.ex4
ea_template/compile.log
ea_template/compile_*.log
# root-level transient compile logs
/compile_*.log

# transient intake staging drop (raw vendor EA source/binaries, ~580MB, regenerable
# from user's source archive; flows through INTAKE_QUEUE funnel — not curated work)
_intake_drop/

# _mt5_auto transient artifacts (reports/ini/logs are bulky + regenerable)
_mt5_auto/reports/
_mt5_auto/_archive/
_mt5_auto/ini/
_mt5_auto/EA_runs/
_mt5_auto/optimizations/
_mt5_auto/*.txt
_mt5_auto/*.log
# keep .set / .json / .ps1 (curated configs + results)

# MT4 auto artifacts
_mt4_auto/reports/
_mt4_auto/optimizations/

# Large zip archives (EA vendor zips, session archives)
*.zip

# Strategy idea bank (vendor EA binaries + zips — not curated work)
strategy_idea_bank/

# Archive folder (historical session zips)
ARCHIVE/

# MT5/MT4 binary data files
*.tib
*.fxt
*.hcc
