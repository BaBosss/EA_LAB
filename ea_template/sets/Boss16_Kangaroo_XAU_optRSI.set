; Boss16_Kangaroo_XAU_optRSI.set - ORDER-075 entry sweep v1 (BUY instance only).
; Base = Boss16_Kangaroo_XAU_smoke.set (ORDER-072 defaults) with optimize ranges
; on the two entry levers ONLY:
;   _16_RsiPeriod {7,14,21}  x  _16_RsiLow {25,30,35,40}  = 12 combos per TF.
; Run twice (H1 + M30) via mt5_optimize.ps1 -Optimization 1 (complete mode);
; TF is the tester Period, not an input. XAUUSD 2023.01.01-2026.07.01 Model 1,
; deposit 10000, leverage 1:2000. Grid/exit axes LOCKED (isolate entry).
;
; Mode selectors (informational for entry 16 - Kangaroo.mqh owns the pipeline)
ExitMode=22
SLMode=33
FirstLotMode=41
LotProg=50
TradeDir=60
TrendFilter=70
RecoveryMode=80
HedgeMode=0
DryRun=false
_0_BarOpenOnly=false
StackMode=90
StackConfirm=0
;
; 16 Entry: RSI fade (chart TF) - SWEEP AXES
_16_Direction=1
_16_RsiPeriod=14||7||7||21||Y
_16_RsiLow=30.0||25.0||5.0||40.0||Y
_16_RsiHigh=70.0
;
; 16 Grid: ATR spacing, ADVERSE adds only, hard cap (LOCKED)
_16_AtrMultFirst4=0.8
_16_AtrMultAfter=1.4
_16_MinDistPips=150.0
_16_MaxOrdersPerSide=10
;
; 16 Lots: FLAT (ladder off) (LOCKED)
_16_BaseLot=0.01
_16_LadderMult=1.0
_16_MaxLotPerOrder=1.0
;
; 16 SL / exits (single exit owner = Kangaroo engine) (LOCKED)
_16_SlAtrMult=18.0
_16_MaxSlPips=9000.0
_16_TpSingleAtrMult=0.35
_16_BasketTpUsdPer01=16.0
_16_OverlapMinUsd=5.0
_16_OverlapMinOrders=4
_16_FlattenOn=false
_16_FlattenMinOrders=6
_16_MaxControlledLossUsd=400.0
_16_EmergencyDDPct=70.0
;
; Protection cage (chassis defaults - supreme above the Kangaroo engine)
ProtectLevel=2
RC_MaxLot=0.20
RC_RecMultMax=1.3
RC_MaxLevelsOverride=0
RC_AcctDDLimitPct=0.0
RC_PersistHalt=true
;
; General
_0_Magic=990016
_0_Slippage=20
_0_MaxSpread=0
