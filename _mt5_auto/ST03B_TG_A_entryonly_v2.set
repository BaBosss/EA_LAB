; EA_RUNNER_ST03B = ST03 + TREND/ADX gate (block entries when ADX>InpAdxMax). 2026-06-26
; Hypothesis: edge dies in TRENDS not vol. ADX gate sits out trending regimes.
InpEnableLogging=true
InpEnableDiagnostics=true
InpEnableRiskEngine=true
InpAllowLiveOrders=true
InpMagic=990010
InpHoldBars=80
InpDeviationPoints=20
InpMacdFast=12
InpMacdSlow=26
InpMacdSignal=9
InpStopLossPoints=0
InpTakeProfitPoints=600
InpVerboseLogging=false
InpCountBars=2
InpLotRepeat=1
InpTp1Pts=200
InpTp2Pts=100
InpTp3Pts=50
InpNearbyPip=50
InpPendingMode=2
InpTrailingPoints=0
InpSessionFilter=false
InpUseMtfGate=false
InpCloseOnReverseSignal=false
InpLotSizerMode=0
InpLotSizerBase=0.01
InpLotSizerStep=0.01
InpLotSizerMax=0.10
InpLotSizerLegs=5
InpLotSizerOnMax=0
InpTrendGateOn=true
InpAdxPeriod=14
InpAdxMax=30
InpVolGateOn=false
InpEdgeTrigger=true
