; EA_RUNNER_ST03 v2 + VOL-GATE TUNED (2026-06-26)
; Vol-gate: skip new entries when ATR(curr) > ATR_MA(300) * 1.5 = long-baseline regime filter.
; Effect (M1): Brexit2016 Net -218 -> +94 (cut 2 tail trades); calm 2024 -5% only.
; Removes the no-SL crisis tail at near-zero calm cost -> intended to unlock larger sizing.
InpEnableLogging=true
InpEnableDiagnostics=true
InpEnableRiskEngine=true
InpAllowLiveOrders=false
InpMagic=990010
InpHoldBars=80
InpDeviationPoints=20
InpMacdFast=12
InpMacdSlow=26
InpMacdSignal=9
InpStopLossPoints=0
InpTakeProfitPoints=600
InpVerboseLogging=false
InpCountBars=2
InpLotRepeat=2
InpTp1Pts=200
InpTp2Pts=100
InpTp3Pts=50
InpNearbyPip=50
InpPendingMode=2
InpTrailingPoints=0
InpSessionFilter=false
InpUseMtfGate=false
InpCloseOnReverseSignal=false
InpLotSizerMode=0
InpLotSizerBase=0.01
InpLotSizerStep=0.01
InpLotSizerMax=0.10
InpLotSizerLegs=5
InpLotSizerOnMax=0
InpVolGateOn=true
InpVolGateMax=1.5
InpEdgeTrigger=true
