; O095A_FLAT_baseline.set
; ORDER-095-A flat-lot edge-check baseline (STEP 1). Identical to O095A_FULL_baseline.set
; EXCEPT: LotProg=50 (PROG_NONE, disables log-power escalation) and _41_FixedLot=0.01
; (fixed 0.01 lot every leg). Grid stacking (StackMode=92, up to 6 levels) stays ON so
; this isolates whether the ENTRY has edge before the grid is allowed to escalate lot size.
;
; Mode selectors
ExitMode=22
SLMode=33
FirstLotMode=41
LotProg=50
TradeDir=60
TrendFilter=70
RecoveryMode=80
HedgeMode=0
DryRun=false
_0_BarOpenOnly=true
;
; 9x Stack
StackMode=92
StackConfirm=0
_9_StepUseATR=true
_9_StepATRmult=1.4
_9_StepPoints=300
_9_StepMinPips=20.0
_9_StepATRShift=1
_9_MaxLevels=6
;
; 14 Entry: GridLog
_14_Direction=1
_14_DistAtrMult=1.4
_14_MinDistPips=20.0
;
; 2x Exit/TP + partial close
_22_TP_ATRmult=3.0
_2_SuppressLegTP=true
_2_BasketTP_Money=250
_2_PartialPct1=50.0
_2_PartialFrac1=0.30
_2_PartialPct2=75.0
_2_PartialFrac2=0.30
;
; 3x Stop loss
_33_SL_ATRmult=4.0
_33_SL_MaxPips=150.0
_33_AdaptiveON=false
_32_SL_Money=0
;
; ATR (signal + risk)
_0_ATR_Period=14
_0_ATR_TF=0
_3_RiskATR_Period=14
_3_RiskATR_TF=0
;
; 4x/5x Money management - FLAT CHECK: escalation OFF, fixed 0.01 lot
_41_FixedLot=0.01
_55_LogPowerFactor=1.3
_55_UseLnNotLog10=true
_4_DdAdaptiveOn=false
_4_DdTier1Pct=10.0
_4_DdTier1Mult=1.2
_4_DdTier2Pct=20.0
_4_DdTier2Mult=1.5
_4_DdHardCapMult=1.5
;
; 0x Protection cage
ProtectLevel=2
RC_MaxLot=3.0
RC_RecMultMax=1.5
RC_MaxLevelsOverride=6
;
; General
_0_Magic=990396
_0_Slippage=20
_0_MaxSpread=0
