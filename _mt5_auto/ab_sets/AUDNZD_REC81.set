; Boss14_GridLog_AUDNZD_ISpick.set
; Parity backtest set - maps ZeusInspired_AUDJPY_lot20x.set (standalone
; (Boss)_ZeusInspired_GridLog_rev01.mq5) onto Boss_14_GridLog chassis inputs.
; Mechanical IS pick for AUDNZD; ORDER-006
; Selected from IS optimizer: highest PF among Trades>=50
;
; Mode selectors
ExitMode=22
SLMode=33
FirstLotMode=41
LotProg=55
TradeDir=60
TrendFilter=70
RecoveryMode=81
HedgeMode=0
DryRun=false
; Zeus evaluates its ENTIRE OnTick once per bar (g_bar_checked gate) - partial close,
; basket TP, grid adds, emergency DD all sample once per bar-open. Without this the
; chassis re-fires partials on intrabar profit oscillation (attempt-3 pathology: 144 trades).
_0_BarOpenOnly=true
;
; 9x Stack - GridLog default is STACK_GRID_AGAINST(92)/CONF_DISTANCE(0), set explicitly for clarity
StackMode=92
StackConfirm=0
_9_StepUseATR=true
_9_StepATRmult=1.4
_9_StepPoints=300
_9_StepMinPips=20.0
_9_StepATRShift=1
_9_MaxLevels=6
;
; 14 Entry: GridLog
_14_Direction=1
_14_DistAtrMult=1.4
_14_MinDistPips=20.0
;
; 2x Exit/TP + partial close
; _2_SuppressLegTP=true: standalone Zeus legs carry TP=0.0 (basket-money-TP only,
; + per-leg SL). Without this, chassis EXIT_ATR_TP attaches a live per-leg TP that
; lets legs close independently of the basket, fragmenting baskets (found attempt 2).
_22_TP_ATRmult=3.0
_2_SuppressLegTP=true
_2_BasketTP_Money=175
_2_PartialPct1=50.0
_2_PartialFrac1=0.30
_2_PartialPct2=75.0
_2_PartialFrac2=0.30
;
; 3x Stop loss - Risk-ATR x mult, capped: standalone slPips = min(4.0*ATR/pip, 150)
; the 150-pip ceiling DOES bind in high-ATR stretches (AUDJPY 4xATR > 150 pips) -
; without it, port legs carry wider SLs, live longer, and fragment via partials
_33_SL_ATRmult=4.0
_33_SL_MaxPips=150.0
_33_AdaptiveON=false
_32_SL_Money=0
;
; ATR (signal + risk) - both periods = standalone _01_AtrPeriod=14
_0_ATR_Period=14
_0_ATR_TF=0
_3_RiskATR_Period=14
_3_RiskATR_TF=0
;
; 4x/5x Money management
_41_FixedLot=0.10
_55_LogPowerFactor=1.3
_55_UseLnNotLog10=true
_4_DdAdaptiveOn=false
_4_DdTier1Pct=10.0
_4_DdTier1Mult=1.2
_4_DdTier2Pct=20.0
_4_DdTier2Mult=1.5
_4_DdHardCapMult=1.5
;
; 0x Protection cage - PROTECT_NORMAL(2) => KillDD=25.0% matches standalone _06_EmergencyDdPct=25.0
; RC_MaxLevelsOverride=6 decouples stack depth from PROTECT_NORMAL's RC_MaxRecSteps=3
; (that value is sized for Recovery-mode steps, not this entry's 6-leg grid depth) while
; KillDD/DepositLoad still come from ProtectLevel=2 untouched, matching standalone _06_MaxPositions=6.
ProtectLevel=2
RC_MaxLot=3.0
RC_RecMultMax=1.5
RC_MaxLevelsOverride=6
;
; General
_0_Magic=990202
_0_Slippage=20
_0_MaxSpread=0


