; ORDER-158 part (2) Hedge/Recovery sweep harness BASE set.
; NOT a deployed EA - Magic=990902 is a dedicated harness-only magic, deliberately
; outside the 990201-990208 range that IS deployed live on account 415573666
; (Boss_14_GridLog bench, see portfolio/DEPLOYMENTS.csv) so this backtest artifact
; can never be confused with, or collide with, the deployed AUDNZDm/AUDCADm legs.
; Content otherwise = a straight copy of _mt5_auto/ab_sets/AUDNZD_REC80.set
; (the existing IS-pick reference), i.e. RecoveryMode/HedgeMode below are the
; TRUE (80,0) OFF/OFF baseline cell - scripts/hedge_recovery_sweep.ps1 overrides
; both per cell.
;
; Mode selectors
ExitMode=22
SLMode=33
FirstLotMode=41
LotProg=55
TradeDir=60
TrendFilter=70
RecoveryMode=80
HedgeMode=0
DryRun=false
_0_BarOpenOnly=true
;
; 9x Stack - GridLog default is STACK_GRID_AGAINST(92)/CONF_DISTANCE(0)
StackMode=92
StackConfirm=0
_9_StepUseATR=true
_9_StepATRmult=1.4
_9_StepPoints=300
_9_StepMinPips=20.0
_9_StepATRShift=1
_9_MaxLevels=6
;
; 14 Entry: GridLog
_14_Direction=1
_14_DistAtrMult=1.4
_14_MinDistPips=20.0
;
; 2x Exit/TP + partial close
_22_TP_ATRmult=3.0
_2_SuppressLegTP=true
_2_BasketTP_Money=175
_2_PartialPct1=50.0
_2_PartialFrac1=0.30
_2_PartialPct2=75.0
_2_PartialFrac2=0.30
;
; 3x Stop loss
_33_SL_ATRmult=4.0
_33_SL_MaxPips=150.0
_33_AdaptiveON=false
_32_SL_Money=0
;
; ATR (signal + risk)
_0_ATR_Period=14
_0_ATR_TF=0
_3_RiskATR_Period=14
_3_RiskATR_TF=0
;
; 4x/5x Money management
_41_FixedLot=0.10
_55_LogPowerFactor=1.3
_55_UseLnNotLog10=true
_4_DdAdaptiveOn=false
_4_DdTier1Pct=10.0
_4_DdTier1Mult=1.2
_4_DdTier2Pct=20.0
_4_DdTier2Mult=1.5
_4_DdHardCapMult=1.5
;
; 0x Protection cage
ProtectLevel=2
RC_MaxLot=3.0
RC_RecMultMax=1.5
RC_MaxLevelsOverride=6
;
; General - harness-only magic, see header
_0_Magic=990902
_0_Slippage=20
_0_MaxSpread=0
