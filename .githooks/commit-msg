#!/bin/sh
# EA_LAB commit-msg guard.
#
# WHY THIS FILE EXISTS (2026-07-27, found while trying to land ORDER-432)
#   ORDER-144 added a rule to scripts/check_precommit_staged.ps1: changing
#   ea_template/regression_baseline.csv requires the word "re-pin" in the commit
#   message. The intent is right -- moving a regression baseline is exactly the kind
#   of thing that should need an explicit declaration, because the baseline is the
#   only record of what the chassis used to do.
#
#   But it was implemented in the PRE-COMMIT hook, reading .git/COMMIT_EDITMSG. Under
#   `git commit -m`, git writes COMMIT_EDITMSG only on SUCCESS, after pre-commit has
#   already run -- so at pre-commit time that file still holds the PREVIOUS commit's
#   message. The rule was therefore gating on the wrong input entirely: it could only
#   pass by accident, when the last successful commit happened to contain "re-pin".
#
#   Demonstrated twice on 2026-07-27 with messages that plainly contained the word and
#   were still blocked. Of the eight commits that have ever touched the baseline, only
#   one postdates the guard -- so this had almost no chance to be noticed in normal use.
#
#   commit-msg is the correct hook: git passes it the path to the actual message as $1.
#
# Fail-CLOSED on a missing message file: a rule that cannot read its input must block,
# not wave the commit through. That is the whole lesson above.

msgfile="$1"
if [ -z "$msgfile" ] || [ ! -f "$msgfile" ]; then
  echo "[commit-msg] FAIL-CLOSED: no commit message file passed (\$1='$msgfile') -- cannot validate, blocking"
  exit 1
fi

baseline_paths='ea_template/regression_baseline.csv
ea_template/regression_baseline.active.json
ea_template/regression_baseline_build6090.csv
ea_template/regression_baseline_build6090.manifest.json
ea_template/regression_baseline_build5836.manifest.json'
changed_baseline=0
changed_build6090=0
while IFS= read -r path; do
  [ -z "$path" ] && continue
  if git diff --cached --name-only -- "$path" | grep -q . && ! git diff --cached --quiet -- "$path"; then
    changed_baseline=1
    case "$path" in
      ea_template/regression_baseline_build6090.*|ea_template/regression_baseline.active.json) changed_build6090=1 ;;
    esac
  fi
done <<EOF
$baseline_paths
EOF

if git diff --cached --name-only -- ea_template/regression_baseline.csv | grep -q . && ! git diff --cached --quiet -- ea_template/regression_baseline.csv; then
  echo "[commit-msg] BLOCK: historical Build-5836 CSV is byte-protected and cannot be re-pinned."
  exit 1
fi

# Only act when the baseline is actually staged AND its staged bytes differ from HEAD.
# A commit that merely touches other files, or re-stages identical bytes, is a no-op here.
if [ "$changed_baseline" -eq 1 ]; then
    if ! grep -qi 're-pin' "$msgfile"; then
      echo ""
      echo "[commit-msg] BLOCK: versioned TPL baseline files changed, but the commit message does not contain 're-pin'."
      echo "[commit-msg] The baseline is the only record of what the chassis used to do. Moving it needs"
      echo "[commit-msg] an explicit declaration in the message, stating WHICH EAs moved and WHY the old"
      echo "[commit-msg] numbers were wrong -- not just the token."
      echo "[commit-msg] (ORDER-144 rule; relocated from pre-commit 2026-07-27, where it was reading the"
      echo "[commit-msg]  PREVIOUS commit's message and could never see this one.)"
      echo ""
      exit 1
    fi
fi
if [ "$changed_build6090" -eq 1 ] && ! grep -Eqi 'BUILD-6090[- ]+PROVENANCE[- ]+MIGRATION' "$msgfile"; then
  echo "[commit-msg] BLOCK: Build-6090 baseline artifacts require BUILD-6090-PROVENANCE-MIGRATION in the commit message."
  exit 1
fi

# ---------------------------------------------------------------------------
# ORDER-500 (user ratified option B, 2026-07-28): B1_DATASET.csv append-only,
# with an AUDITED repair path.
#
# WHY HERE AND NOT IN PRE-COMMIT
#   The ORDER-144 rule made B1_DATASET.csv strictly append-only with no escape hatch of
#   any kind. On 2026-07-28 that met a legitimate case it could not express: ORDER-280's
#   row had been glued onto the tail of ORDER-412's quoted notes with no line break, so
#   the file parsed as 83 rows instead of 84 and one row carried 25 fields. The one-byte
#   repair was written, verified, staged -- and correctly BLOCKED. The guard was right
#   and was not bypassed, but the only routes left were --no-verify or leaving the file
#   broken, and a guard that refuses a legitimate case with no sanctioned path is how
#   override habits get taught (memory `feedback-audit-rule-rationale-not-compliance`).
#
#   The sibling rule above already had this shape, so B1 now matches it: a repair is
#   possible, but never silent. The default did not move -- an undeclared modification is
#   still blocked, exactly as before.
#
#   Pre-commit cannot host this rule: it would have to block before commit-msg ever runs,
#   so the escape hatch could never open. The row-shape assertion that ORDER-500 also
#   added DOES live in pre-commit, because it needs no message.
b1='docs/memory_control/B1_DATASET.csv'

if git diff --cached --name-only -- "$b1" | grep -q .; then
  if ! git diff --cached --quiet -- "$b1"; then
    # Is HEAD an exact byte prefix of the staged blob? Anything else is a modification.
    # Compared via git's own object store, never via the working tree.
    head_blob=$(git rev-parse --verify --quiet "HEAD:$b1" 2>/dev/null || true)
    if [ -n "$head_blob" ]; then
      head_size=$(git cat-file -s "$head_blob")
      staged_blob=$(git rev-parse --verify --quiet ":$b1" 2>/dev/null || true)
      if [ -z "$staged_blob" ]; then
        echo "[commit-msg] FAIL-CLOSED: $b1 is staged but its blob could not be read -- blocking"
        exit 1
      fi
      staged_size=$(git cat-file -s "$staged_blob")

      prefix_ok=1
      if [ "$staged_size" -lt "$head_size" ]; then
        prefix_ok=0
      else
        # Compare the first head_size bytes of both blobs. Written with temp files rather
        # than process substitution: the shebang is /bin/sh and `<(...)` is a bashism that
        # would silently fail here -- a guard that errors out is a guard that is off.
        tmp_head=$(mktemp) || { echo "[commit-msg] FAIL-CLOSED: mktemp failed"; exit 1; }
        tmp_pre=$(mktemp) || { rm -f "$tmp_head"; echo "[commit-msg] FAIL-CLOSED: mktemp failed"; exit 1; }
        git cat-file blob "$head_blob" > "$tmp_head"
        git cat-file blob "$staged_blob" | head -c "$head_size" > "$tmp_pre"
        if ! cmp -s "$tmp_pre" "$tmp_head"; then
          prefix_ok=0
        fi
        rm -f "$tmp_head" "$tmp_pre"
      fi

      if [ "$prefix_ok" -eq 0 ]; then
        if ! grep -q 'B1-REPAIR' "$msgfile"; then
          echo ""
          echo "[commit-msg] BLOCK: $b1 modifies existing bytes (it is append-only by default)."
          echo "[commit-msg]"
          echo "[commit-msg] If this is an ordinary append, something rewrote earlier bytes by accident --"
          echo "[commit-msg] check for a line-ending rewrite or an editor reformat before going further."
          echo "[commit-msg]"
          echo "[commit-msg] If this IS a deliberate repair, declare it: put B1-REPAIR in the commit message"
          echo "[commit-msg] together with WHICH rows changed and WHY the existing bytes were wrong. The"
          echo "[commit-msg] token alone is not the point -- the audit trail is."
          echo "[commit-msg] (ORDER-500, user ratified 2026-07-28. The append-only default is unchanged;"
          echo "[commit-msg]  this adds a declared path, it does not relax the rule.)"
          echo ""
          exit 1
        fi
        echo "[commit-msg] B1-REPAIR declared -- $b1 may modify existing bytes in this commit."
        echo "[commit-msg] Row shape is still enforced by pre-commit; a declared repair is not exempt from it."
      fi
    fi
  fi
fi

exit 0
