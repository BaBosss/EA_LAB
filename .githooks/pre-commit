#!/bin/sh
# EA_LAB anti-drift pre-commit guard (see PROJECT_STATE.md section 0.5) +
# ORDER-103 Contract C1-ENFORCE Fix 2: fail-closed staged-snapshot protected-set
# guard (scripts/check_precommit_staged.ps1).
#
# This hook enforces two independent things:
#   1. scripts/check_state.ps1 -Strict on every commit (unchanged behavior).
#   2. scripts/check_precommit_staged.ps1 -- ONLY does real work when a
#      PROTECTED-SET file (the archive, AGENT_TASKBOARD.md, or one of the 3
#      generated docs/memory_control artifacts) is staged; otherwise it is a
#      fast no-op pass. Reads the git INDEX (staged bytes), never the working
#      tree, so `git commit` always judges what will actually land.
#
# =========================================================================================
# D-F4 (Audit D, 2026-08-20) -- HOOKSPATH ASSERTION, ON THE COMMIT PATH, FIRST.
#
# REPRODUCED LIVE at canonical 649207d6: the PRIMARY checkout's .git/config carries
#   core.hooksPath = D:\EA_LAB\.githooks
# at LOCAL scope, which is SHARED by every linked worktree. `extensions.worktreeConfig` is
# true, so the fix is a per-worktree pin -- but until one is applied, a brand-new CLEAN linked
# worktree resolves its hooks to the DIRTY PRIMARY's .githooks. Measured there:
#   git -C <linked-worktree> rev-parse --git-path hooks  ->  D:\EA_LAB\.githooks
# and .githooks/fast_tier_pathspec is currently MODIFIED in that dirty tree. So the guard bytes
# that judge a commit in worktree A can be whatever somebody is mid-edit on in worktree B, and
# nothing said so. That is not a hook being bypassed loudly; it is a hook being SWAPPED quietly.
#
# THE CONTRACT (stated here so Lane 2's tracked negative fixture can be reconciled with it):
#
#   A1  BYTES  -- REFUSE. dirname($0), canonicalized, must equal <toplevel>/.githooks,
#                 canonicalized. This is an OBSERVATION of which file is executing, not an
#                 inference from config: it is the only check that catches "foreign tree" and
#                 "absolute-to-another-tree" directly, because those differ from the correct
#                 case in exactly this value.
#   A2a EMPTY  -- REFUSE. An effective core.hooksPath that is unset or the empty string.
#                 HONEST LIMIT: with hooksPath truly empty git does not run this file at all,
#                 so this branch is reachable only via .git/hooks or an explicit invocation.
#                 The empty case is therefore ALSO asserted from outside, in
#                 scripts/_test/run_hookspath_assertion_tests.ps1, which drives real commits in
#                 a fixture repo. A guard cannot be the only witness to its own absence.
#   A2b SCOPE  -- REFUSE. The dir git actually resolved (`rev-parse --git-path hooks`),
#                 canonicalized, must equal <toplevel>/.githooks.
#   A2c CONVEN -- WARN ONLY, and deliberately not a refusal. An ABSOLUTE hooksPath that still
#                 points at THIS worktree's own .githooks runs the correct bytes (A1 and A2b
#                 both pass); it is a convention violation and a latent hazard for the NEXT
#                 linked worktree, not a live leak. The primary operator checkout is in exactly
#                 this state today, and turning that into a hard block would stop the owner
#                 committing for a reason that is not yet a defect. The exact one-line repair is
#                 printed instead.
#
# Keeps the relative `.githooks` convention: `.githooks` is the ONLY value that passes silently.
# =========================================================================================
_hp_top=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -z "$_hp_top" ]; then
  echo "PRECOMMIT-FAIL-CLOSED: cannot resolve the committing worktree (git rev-parse --show-toplevel gave nothing) -- refusing to run guards whose provenance cannot be established"
  exit 1
fi
_hp_canon() { ( cd "$1" 2>/dev/null && pwd -P ) 2>/dev/null || true; }
_hp_want=$(_hp_canon "$_hp_top/.githooks")
_hp_self=$(_hp_canon "$(dirname "$0")")
_hp_raw=$(git config --get core.hooksPath 2>/dev/null || true)
_hp_res=$(_hp_canon "$(git rev-parse --git-path hooks 2>/dev/null)")

if [ -z "$_hp_want" ]; then
  echo "PRECOMMIT-FAIL-CLOSED: $_hp_top/.githooks does not exist -- this worktree has no canonical hook directory"
  exit 1
fi
# A1 -- which bytes are executing
if [ -z "$_hp_self" ] || [ "$_hp_self" != "$_hp_want" ]; then
  echo "PRECOMMIT-FAIL-CLOSED (D-F4/A1): the pre-commit hook that is RUNNING does not belong to the committing worktree."
  echo "  executing hook dir : ${_hp_self:-<unresolvable>} (from \$0 = $0)"
  echo "  this worktree wants: $_hp_want"
  echo "  core.hooksPath     : '${_hp_raw:-<unset>}'"
  echo "  Guard bytes from another checkout judged this commit. Pin this worktree:"
  echo "      git config --worktree core.hooksPath .githooks"
  exit 1
fi
# A2a -- empty/unset
if [ -z "$_hp_raw" ]; then
  echo "PRECOMMIT-FAIL-CLOSED (D-F4/A2a): core.hooksPath is unset or empty, so nothing pins the hook directory."
  echo "      git config --worktree core.hooksPath .githooks"
  exit 1
fi
# A2b -- git's own resolution must land inside this worktree
if [ -z "$_hp_res" ] || [ "$_hp_res" != "$_hp_want" ]; then
  echo "PRECOMMIT-FAIL-CLOSED (D-F4/A2b): git resolves core.hooksPath OUTSIDE the committing worktree."
  echo "  core.hooksPath     : '$_hp_raw'"
  echo "  resolves to        : ${_hp_res:-<unresolvable>}"
  echo "  this worktree wants: $_hp_want"
  echo "      git config --worktree core.hooksPath .githooks"
  exit 1
fi
# A2c -- convention. WARN, never block: the bytes are right, the pin is not.
if [ "$_hp_raw" != ".githooks" ]; then
  echo "[pre-commit] WARN (D-F4/A2c): core.hooksPath is '$_hp_raw', not the relative '.githooks'."
  echo "[pre-commit]   The correct bytes ran (A1/A2b passed), so this commit is not compromised. But a"
  echo "[pre-commit]   non-relative value at shared scope is what makes the NEXT linked worktree resolve"
  echo "[pre-commit]   its hooks to THIS tree. Repair: git config --worktree core.hooksPath .githooks"
fi

# =========================================================================================
# D-F2 (Audit D, 2026-08-20) -- STAGED GITLINK REFUSAL.
#
# `git add -A` in a repo that holds nested worker repositories stages them as mode 160000
# gitlinks. A gitlink commits a POINTER to a commit in a repository this project does not have,
# does not fetch, and cannot check out -- so the tree looks fine and is unreconstructable.
#
# FAIL CLOSED TODAY, and this is verified rather than assumed: this repo has NO .gitmodules
# (`git ls-files | grep gitmodules` is empty at canonical 649207d6), therefore there is no
# governed submodule and EVERY staged gitlink is unintended.
#
# NOT a permanent block on a future governed submodule: if a valid .gitmodules lands and
# DECLARES the path, it is allowed. The declaration is read with `git config --blob :.gitmodules`
# -- git's own config parser, against the INDEX blob (what will land), so a malformed file
# yields no declarations and the gitlink stays refused rather than being waved through.
#
# The mode comes from the RAW MODE FIELD of the INDEX and of HEAD's tree -- git plumbing, not
# any parsed convenience output: comparing parsed fields instead of raw bytes/modes has already
# produced two false-green guards in this repo on live-money files
# (guard-compares-parsed-fields-not-bytes).
#
# WHY NOT `git diff --cached --raw` (tried first, REJECTED, 2026-08-20): it drives git's
# submodule-aware diff FORMATTER, which reads the staged `.gitmodules` blob AS CONFIG for any
# 160000 entry in the diff. A malformed staged `.gitmodules` makes that formatter itself fatal
# -- `git diff --cached --raw` exits 128 and prints NO raw lines at all -- which silently
# emptied the gitlink list and DISARMED THIS ENTIRE GATE for exactly the attack it exists to
# catch (a malformed .gitmodules laundering a gitlink). Reproduced directly: staging a 1-line
# garbage `.gitmodules` alongside a gitlink turned the refusal into total silence. `git
# ls-files --stage` (pure index read) and `git ls-tree -r HEAD` (pure tree read) are plumbing
# only, never consult .gitmodules, and cannot be crashed by a broken one.
# =========================================================================================
# field 2 of the metadata half is the DESTINATION mode. Source-side 160000 is skipped on
# purpose: REMOVING a gitlink is the repair, and a guard that blocks its own remedy is the
# prohibition-disarms-its-own-check shape.
_gl_idx=$(git ls-files --stage | awk -F'\t' '{ split($1, f, " "); if (f[1] == "160000") print f[2]"\t"$2 }')
_gl=$(printf '%s\n' "$_gl_idx" | while IFS="$(printf '\t')" read -r _gl_sha _gl_path; do
  [ -z "$_gl_path" ] && continue
  _gl_head=$(git ls-tree HEAD -- "$_gl_path" 2>/dev/null)
  _gl_head_mode=$(printf '%s' "$_gl_head" | awk '{print $1}')
  _gl_head_sha=$(printf '%s' "$_gl_head" | awk '{print $3}')
  # unchanged relative to HEAD (same mode, same object) -- not something THIS commit
  # introduces, so it is not this gate's job to relitigate an already-committed state.
  if [ "$_gl_head_mode" = "160000" ] && [ "$_gl_head_sha" = "$_gl_sha" ]; then continue; fi
  printf '%s\n' "$_gl_path"
done)
if [ -n "$_gl" ]; then
  _gl_declared=""
  if git cat-file -e :.gitmodules 2>/dev/null; then
    _gl_declared=$(git config --blob :.gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null | sed 's/^[^ ]* //')
  fi
  # newline-delimited read, not word splitting: a path with a space must not become two paths.
  _gl_bad=$(printf '%s\n' "$_gl" | while IFS= read -r p; do
    [ -z "$p" ] && continue
    if [ -n "$_gl_declared" ] && printf '%s\n' "$_gl_declared" | grep -Fxq -- "$p"; then continue; fi
    printf '%s\n' "$p"
  done)
  if [ -n "$_gl_bad" ]; then
    echo "PRECOMMIT-FAIL-CLOSED (D-F2): this commit stages GITLINK entries (mode 160000):"
    printf '%s\n' "$_gl_bad" | while IFS= read -r p; do [ -n "$p" ] && echo "    $p"; done
    echo ""
    echo "[pre-commit] This repo has no .gitmodules, so a staged mode-160000 entry is a NESTED WORKER"
    echo "[pre-commit] REPOSITORY that 'git add -A' swept up, not a submodule. Committing it writes a"
    echo "[pre-commit] pointer to a commit nothing here can fetch. Unstage it:"
    printf '%s\n' "$_gl_bad" | while IFS= read -r p; do [ -n "$p" ] && echo "[pre-commit]     git rm --cached \"$p\""; done
    echo "[pre-commit] (and add the path to .gitignore so it does not come back)."
    exit 1
  fi
  echo "[pre-commit] staged gitlink(s) are DECLARED in .gitmodules -- allowed (governed submodule)."
fi

# Fail-CLOSED: if PowerShell cannot be found at all, this hook BLOCKS the
# commit (exit 1) with the diagnostic string below -- it does not silently
# skip the checks the way the pre-ORDER-103 version of this hook used to.
ps=$(command -v powershell.exe 2>/dev/null || command -v pwsh 2>/dev/null || true)
if [ -z "$ps" ]; then
  echo "PRECOMMIT-FAIL-CLOSED: PowerShell not found (powershell.exe/pwsh) -- cannot run check_state.ps1 / check_precommit_staged.ps1, blocking commit"
  exit 1
fi

# ORDER-674: THE FRONT GUARDS JUDGE THE COMMIT TOO, and until now they judged the working
# tree. Proved before the fix: a duplicate account|magic STAGED into portfolio/DEPLOYMENTS.csv
# with a clean worktree copy left check_state printing "[OK] no duplicate account|magic" and
# "CLEAN" -- so the commit would write a corrupted LIVE-MONEY inventory with the gate green.
#
# Set ONCE, here, for every guard below AND for the tier (which re-sets the same value for its
# own children). ORDER-670's design prefers an ARGUMENT over an env var because an argument
# cannot fail to arrive -- that reasoning was about a hook -> tier -> suite -> python chain
# four hops long. These guards are ONE hop from this line, and `Get-EvidenceMode` REFUSES any
# value that is neither 'index' nor 'worktree', so a mangled variable fails loudly instead of
# silently meaning worktree. Each migrated guard prints its ##EVIDENCE-MODE## marker so a
# reader can see which bytes were judged rather than trusting this comment.
export EA_LAB_EVIDENCE=index

"$ps" -NoProfile -ExecutionPolicy Bypass -File scripts/check_state.ps1 -Strict
rc=$?
if [ "$rc" -ne 0 ]; then
  echo ""
  echo "[pre-commit] doc drift detected (above) -- check_state.ps1 -Strict failed."
  exit $rc
fi

"$ps" -NoProfile -ExecutionPolicy Bypass -File scripts/check_precommit_staged.ps1
rc=$?
if [ "$rc" -ne 0 ]; then
  echo ""
  echo "[pre-commit] protected-set staged-snapshot check failed (above) -- ORDER-103 Fix 2."
  exit $rc
fi

# Order-number collision guard (2026-07-26). Fast no-op unless AGENT_TASKBOARD.md is
# staged. BLOCKS a duplicate order id (within the active board, or active-vs-archive)
# and a new order number outside the committing lane's reserved block in
# docs/SESSION_LEDGER.md; WARNS when a staged path belongs to another ACTIVE lane.
# Three renumber-after-the-fact collisions in one month (fd5264f8, 30598b55, and the
# still-unfixed ORDER-098-C double-use) is what a memory-only rule buys you.
"$ps" -NoProfile -ExecutionPolicy Bypass -File scripts/check_order_collision.ps1
rc=$?
if [ "$rc" -ne 0 ]; then
  echo ""
  echo "[pre-commit] order-number collision check failed (above)."
  echo "[pre-commit] If you need a number outside your block, claim one in docs/SESSION_LEDGER.md first."
  exit $rc
fi

# Handoff routing contract (2026-07-26). Fast no-op unless an added/modified handoff
# under _triage/ is staged (archived ones are exempt). BLOCKS a handoff with no
# <!-- HANDOFF-ROUTING --> table, or one whose ORDER-/BACKLOG- destinations do not
# resolve against the real boards. A sweep found 27 forward-looking items that had
# been written into handoffs and never reached AGENT_TASKBOARD.md at all.
"$ps" -NoProfile -ExecutionPolicy Bypass -File scripts/check_handoff_contract.ps1
rc=$?
if [ "$rc" -ne 0 ]; then
  echo ""
  echo "[pre-commit] handoff routing contract failed (above)."
  echo "[pre-commit] Every forward-looking item needs a home: an ORDER on the board, a MASTER_BACKLOG row, or DONE."
  echo "[pre-commit] Format: docs/WORK_LIFECYCLE.md section 2."
  exit $rc
fi

# ORDER-731 (2026-08-01). The attestation gate compares an owner-pinned blob against HEAD:, and
# during a pre-commit hook HEAD is the PREVIOUS commit -- so it was structurally incapable of
# refusing the commit that breaks the pin, AND of accepting the commit that repairs it. Measured
# twice in one afternoon: f4c9fd9f and 78a93129 both passed this hook and turned the gate red the
# moment they landed; restoring MASTER_BACKLOG.md then needed an owner-approved --no-verify,
# because HEAD held the wrong blob and every repairing commit was refused by the same rule.
#
# This guard asks the same question one snapshot earlier, at the INDEX. F5/F11 keep their HEAD
# semantics on purpose: S2A_ATTESTATION_POLICY.md states them and that policy is inside
# bundle_sha256, so moving them there would void the owner's record and cost a signature for a
# repair that changes no rule -- the loop ORDER-614 rev 2 exists to end.
#
# FAIL-CLOSED on a missing interpreter, same rule as the PowerShell block at the top: a guard
# that cannot run must block, never silently skip. Fast no-op when nothing it pins is staged.
py="tools/python312/python.exe"
if [ ! -x "$py" ] && [ ! -f "$py" ]; then
  echo "PRECOMMIT-FAIL-CLOSED: $py not found -- cannot run check_attested_pin_staged.py, blocking commit"
  exit 1
fi
# Linked-worktree hydration (2026-08-18): a fresh linked worktree materializes tracked files
# only, and python312.zip is ignored, so the interpreter above cannot load its stdlib
# (ModuleNotFoundError: encodings) until the archive is copied in from the source checkout.
# Dot-source the canonical provisioning mechanism and let it do that copy (git-common-dir).
# FAIL-CLOSED: a provisioning failure blocks the commit; there is deliberately no fallback to
# a system Python (this box has none, and a different interpreter would change the guard's
# semantics).
"$ps" -NoProfile -ExecutionPolicy Bypass -Command ". ./scripts/use_python.ps1; try { \$exe = Assert-PortablePython -Provision; if (-not \$exe) { throw 'Assert-PortablePython returned no executable' } } catch { Write-Host ('PRECOMMIT-FAIL-CLOSED: portable Python provisioning failed -- ' + \$_.Exception.Message); exit 1 }"
rc=$?
if [ "$rc" -ne 0 ]; then
  echo ""
  echo "[pre-commit] portable Python provisioning failed (above) -- cannot run check_attested_pin_staged.py, blocking commit"
  exit $rc
fi
"$py" _triage/factory_os/check_attested_pin_staged.py
rc=$?
if [ "$rc" -ne 0 ]; then
  echo ""
  echo "[pre-commit] this commit would move a blob an owner attestation pins (above) -- ORDER-731."
  echo "[pre-commit] Refused HERE because F5/F11 read HEAD: once it lands, the gate is red and the"
  echo "[pre-commit] commit that would repair it is refused too. Restore the pinned bytes, or land"
  echo "[pre-commit] the owner's re-attestation in the SAME commit."
  exit $rc
fi

qi_staged=$(git diff --cached --name-only -- 'factory/experiments')
if [ -n "$qi_staged" ]; then
  "$py" _triage/factory_os/qi1_staged_guard.py
  rc=$?
  if [ "$rc" -ne 0 ]; then
    echo ""
    echo "[pre-commit] QI-1 staged append-only/whole-store check failed (above)."
    exit $rc
  fi
fi

event_staged=$(git diff --cached --name-only -- 'docs/memory_control/experiment_events')
if [ -n "$event_staged" ]; then
  "$ps" -NoProfile -ExecutionPolicy Bypass -File scripts/check_experiment_events.ps1
  rc=$?
  if [ "$rc" -ne 0 ]; then
    echo ""
    echo "[pre-commit] experiment-event staged-snapshot check failed (above) -- ORDER-105 Contract D."
    exit $rc
  fi
fi

# ORDER-420 (2026-07-27). The guards above run on every commit. Until now the TESTS for those
# guards ran on nothing -- every suite in scripts/_test/ was manual-only, which is the ORDER-270
# finding ("a cage that never runs protects nothing") applied to a whole directory. Four defects
# in eight days had the same shape: a guard kept running and quietly stopped reporting
# (ORDER-260 substring, ORDER-341 label ranking, ORDER-390 nested backticks, ORDER-370 a
# pipeline .Count that is null for exactly one result). All four were found by a human looking.
#
# Scoped to when a guard or a cage is actually being edited, because that is how you break one.
# Fast no-op on every other commit -- same idiom as the experiment-events block above.
#
# The FAST tier only: 3.8s measured for 4 suites. The slow suites (chainwalk 74s, order101 ~120s,
# order103 ~760s, order105 521s) stay out on purpose. A hook that costs ten minutes gets
# --no-verify'd, and a bypassed hook protects nothing while looking like it protects everything.
# scripts/_test/run_fast_cages.ps1 names what it does not cover.
# ORDER-434 (2026-07-27) added 'scripts/mris/*'. The fast tier now includes a suite that
# guards mris_macro_feeder.ps1, which lives in neither of the two original globs -- so
# without this the cage would have fired only when something OTHER than the file it
# protects was edited. Same class as the finding it was written for: the artifact keeps
# being produced, it just stops being connected to the thing it is about.
# ORDER-500 (2026-07-28) added 'scripts/lib/*' for exactly the reason the ORDER-434
# AUDIT-5 (2026-07-30) measured the pathspec against every input the fast suites actually
# read, and found four more misses BEYOND the _triage ones added the same day:
#   .githooks/pre-commit itself   -- narrowing or deleting this very line triggers no cage
#   docs/PARAM_REGISTRY.csv       -- read by optimize_guard.ps1, which run_optimize_guard_tests exercises
#   docs/PARAM_LINKAGE.md         -- same; a malformed override pair changes guarded behaviour silently
#   _triage/PARAM_INACTIVE_AUDIT.md -- same
# tools/python312/python.exe is a fifth (the binding suite's interpreter) and is deliberately
# NOT added: staging a binary interpreter is not a normal edit, and the suite already fails
# closed when it is missing. Added the other four. This is the FIFTH widening, which is the
# argument for BACKLOG-D32 and not a substitute for it.
# ORDER-500 paragraph, for the record, describes exactly this: b1_guard.ps1 holds the rules that
# check_precommit_staged.ps1 and .githooks/commit-msg both dot-source, and it matched
# none of the three existing globs -- verified by pathspec before widening, not assumed.
# Two consecutive additions have now needed this, which says the glob list is the wrong
# shape: it enumerates directories that happen to hold guarded files, so every new
# location is a silent miss until somebody notices. Recorded rather than fixed here --
# changing the trigger to "any file a fast suite depends on" needs its own cage.
# ORDER-372: THIRD consecutive addition to need this, exactly as the note above predicted.
# run_report_freshness_tests.ps1 guards scripts/lib/report_freshness.ps1 (covered by scripts/lib/*)
# but its PART 5 sweep is over EVERY scripts/*.ps1 -- it exists to catch a caller reintroducing
# "the .htm exists, so this run wrote it". Without scripts/*.ps1 on this list that sweep would only
# run when something else happened to be staged, i.e. it would look enforced and not be. Widened
# rather than enumerated again; the fast tier is 3.7s, which is inside the budget that makes a hook
# survivable. The real fix named above -- deriving this list from what the suites depend on --
# is still owed and still needs its own cage.
# BACKLOG-D31 (2026-07-30): FOURTH addition, and this one was found by staging a design-only
# edit and counting the hook's output lines -- zero. run_contract_binding_tests.ps1 guards
# _triage/EA_LAB_FACTORY_OS_DESIGN.md and _triage/factory_os/schemas.json, neither of which
# matched any glob here, so the cage fired only when a scripts/ file happened to be staged
# alongside. It looked enforced for four commits and was not. The prediction in the ORDER-500
# paragraph above has now come true three times in three days; deriving this list from the
# suites' own declared dependencies is the fix, and it is now BACKLOG-D32, not a comment.
# BACKLOG-D32 (2026-07-30): the hand-enumerated glob above is GONE. The pathspec is now
# generated from what each suite declares it guards ($SUITE_GUARDS in run_fast_cages.ps1)
# by scripts/gen_fast_tier_pathspec.ps1, and run_guard_trigger_tests.ps1 fails when a suite
# has no declaration, when a declared path does not exist, or when this file is stale.
# The five widenings this replaced are kept in the paragraphs above as the reason it exists.
#
# FAIL-CLOSED: if the generated file is missing or empty, RUN the tier. The failure mode
# this whole line exists to prevent is a trigger that silently matches nothing, so an
# unreadable trigger must mean "run everything", never "run nothing".
spec_file=".githooks/fast_tier_pathspec"
if [ -s "$spec_file" ]; then
  cage_spec=()
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] && cage_spec+=("$line")
  done < "$spec_file"
  cage_staged=$(git diff --cached --name-only -- "${cage_spec[@]}")
else
  echo "[pre-commit] $spec_file missing or empty -- running the fast tier unconditionally (fail-closed)."
  cage_staged="FORCED"
fi
if [ -n "$cage_staged" ]; then
  # BACKLOG-D32: hand the tier the staged paths so it runs only the suites that guard them.
  # MEASURED 2026-07-31: the whole tier is 18.1s against a 15.0s advisory budget; a schema edit
  # now costs 3.9s and an optimize_guard.ps1 edit 7.3s.
  # FAIL-OPEN BY CONSTRUCTION: run_fast_cages.ps1 runs EVERYTHING when -StagedPaths is empty, and
  # runs any suite whose guards are undeclared. So "FORCED", an empty list, or a list this hook
  # computed wrongly all run MORE than necessary, never less. run_guard_trigger_tests.ps1 PART 5
  # asserts that, plus that every suite is still reachable by its own declarations.
  # Paths go through a FILE, one per line -- not a comma-joined argument. `powershell -File` bound
  # a comma string as one literal for three paths while splitting it correctly for two, and the
  # commit that introduced this feature ran ZERO suites as a result. A temp file has no quoting,
  # separator or array-binding ambiguity.
  cage_file=""
  if [ "$cage_staged" != "FORCED" ]; then
    cage_file=$(mktemp 2>/dev/null || echo "${TMPDIR:-/tmp}/ea_cage_$$")
    printf '%s\n' "$cage_staged" > "$cage_file"
  fi
  # ORDER-670: -Hook at BOTH call sites, including this fail-closed else-branch -- hook-ness
  # is an ARGUMENT precisely because an argument cannot fail to arrive from a caller that is
  # one file with two lines. Given -Hook the tier sets EA_LAB_EVIDENCE=index for its children
  # and verifies per-suite markers that the mode actually arrived.
  if [ -n "$cage_file" ] && [ -s "$cage_file" ]; then
    "$ps" -NoProfile -ExecutionPolicy Bypass -File scripts/_test/run_fast_cages.ps1 -Hook -StagedPathsFile "$(cygpath -w "$cage_file" 2>/dev/null || echo "$cage_file")"
  else
    "$ps" -NoProfile -ExecutionPolicy Bypass -File scripts/_test/run_fast_cages.ps1 -Hook
  fi
  rc=$?
  [ -n "$cage_file" ] && rm -f "$cage_file"
  if [ "$rc" -ne 0 ]; then
    echo ""
    echo "[pre-commit] a guard's own test suite failed (above) -- ORDER-420."
    echo "[pre-commit] You are editing scripts/check_*.ps1 or scripts/_test/*, and its cage went red."
    echo "[pre-commit] Slow suites are NOT covered here: run_chainwalk_tests (74s), run_order101/103/105."
    exit $rc
  fi
fi

# =========================================================================================
# D-F9 (Audit D, 2026-08-20) -- TASKBOARD_DIGEST STALENESS, NOW ON THE COMMIT PATH.
#
# REPRODUCED at canonical 649207d6: `grep -in digest .githooks/pre-commit` returned NOTHING, and
# `grep -rn make_taskboard_digest` found no caller on any commit path -- the -Check mode existed
# and ran only when a human remembered. That is the ORDER-270 finding ("a cage that never runs
# protects nothing") applied to a generated artifact that is the only human-readable index of
# 403 orders.
#
# PATH-SELECTED, same idiom as the experiment-events and QI-1 blocks above: it does real work
# only when this commit touches one of the three files involved, so an unaffected commit pays
# nothing but the `git diff --cached --name-only` it was already going to run.
#
# JUDGES THE INDEX, NOT THE WORKTREE. make_taskboard_digest.ps1 -Check reads files from -Root, so
# the three index blobs are extracted to a temp root and it is pointed there. Without this the
# gate would answer a question about the working tree while `git commit` writes something else --
# the ORDER-674 defect, which was measured on portfolio/DEPLOYMENTS.csv and is the reason
# EA_LAB_EVIDENCE=index exists at the top of this file.
# =========================================================================================
digest_staged=$(git diff --cached --name-only -- 'AGENT_TASKBOARD.md' 'taskboards/active/*' 'ARCHIVE_TASKBOARD_2026-07A.md' 'TASKBOARD_DIGEST.md')
if [ -n "$digest_staged" ]; then
  dg_root=$(mktemp -d 2>/dev/null || echo "${TMPDIR:-/tmp}/ea_digest_$$")
  mkdir -p "$dg_root"
  dg_ok=1
  for f in AGENT_TASKBOARD.md ARCHIVE_TASKBOARD_2026-07A.md TASKBOARD_DIGEST.md; do
    if ! git cat-file -e ":$f" 2>/dev/null; then
      echo "PRECOMMIT-FAIL-CLOSED (D-F9): ':$f' is not in the index -- the digest gate cannot judge what will land"
      dg_ok=0
      break
    fi
    git show ":$f" > "$dg_root/$f" || { dg_ok=0; break; }
  done
  # Active ORDER blocks may live in split part files declared by AGENT_TASKBOARD.md.
  # Materialize the INDEX versions into the same temp root so make_taskboard_digest -Check
  # judges the exact logical queue this commit will land. Part-only commits must trigger this gate.
  if [ "$dg_ok" -eq 1 ]; then
    git ls-files -- 'taskboards/active/*' > "$dg_root/.active_parts"
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      if ! git cat-file -e ":$f" 2>/dev/null; then
        echo "PRECOMMIT-FAIL-CLOSED (D-F9): ':$f' is not in the index -- split active queue incomplete"
        dg_ok=0
        break
      fi
      mkdir -p "$dg_root/$(dirname "$f")"
      git show ":$f" > "$dg_root/$f" || { dg_ok=0; break; }
    done < "$dg_root/.active_parts"
  fi
  if [ "$dg_ok" -ne 1 ]; then
    rm -rf "$dg_root"
    exit 1
  fi
  "$ps" -NoProfile -ExecutionPolicy Bypass -File scripts/make_taskboard_digest.ps1 -Check -Root "$(cygpath -w "$dg_root" 2>/dev/null || echo "$dg_root")"
  rc=$?
  rm -rf "$dg_root"
  if [ "$rc" -ne 0 ]; then
    echo ""
    echo "[pre-commit] TASKBOARD_DIGEST.md is STALE against the taskboard bytes THIS COMMIT would land (rc=$rc)."
    echo "[pre-commit] Regenerate and stage it in the SAME commit:"
    echo "[pre-commit]     powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make_taskboard_digest.ps1"
    echo "[pre-commit]     git add TASKBOARD_DIGEST.md"
    exit $rc
  fi
fi

# WARN-ONLY (2026-07-16): remind on kill-verdict-without-optimize-evidence. Never blocks (script
# always exits 0); we deliberately do NOT check its rc. Anti-recurrence for default-smoke concept-kills.
"$ps" -NoProfile -ExecutionPolicy Bypass -File scripts/check_verdict_kill.ps1

exit 0
